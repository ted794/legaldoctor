# 스타트업 리걸닥터 실행 설정. 이 파일을 .env로 복사한 뒤 값을 채운다.
# .env는 .gitignore에 들어 있어 저장소에 올라가지 않는다.

# Liner API 키 (Liner Model, Liner Search 공용)
LINER_API_KEY=your-liner-api-key

# 국가법령정보 공동활용 Open API 인증값(OC)
# open.law.go.kr에서 신청할 때 실행 서버의 IP를 등록해야 호출이 통과한다.
# 선택 항목이다. 비워 두거나 인증이 실패하면 국가법령정보센터 웹 화면의 원문을 읽고,
# 그것도 안 되면 data/law_cache의 원문 캐시를 쓴다. 심사 때는 비워 두어도 분석이 동작한다.
LAW_OC=your-law-oc

# 아래는 보통 바꿀 필요가 없다.
# LINER_BASE_URL=https://platform.liner.com/api/v1
# LINER_MODEL=liner-mark-1.0

# 웹 화면 개인정보 처리 안내에 보일 운영자와 문의처(배포 서버에서만 채움)
# LD_OPERATOR=
# LD_CONTACT=

# 남용 방지 한도(0 또는 비우면 끔, 기본 끔)
# LD_HEAVY_PER_HOUR=0
# LD_CARE_PER_HOUR=0
# LD_LIGHT_PER_HOUR=0
# LD_HEAVY_PER_DAY=0

# 규제 변화 피드(선택. 비우면 꺼짐. 형식은 docs/feed_spec.md)
# LD_FEED_URL=
# LD_FEED_TOKEN=
# LD_FEED_NAME=

# 상담 지혜 저장소(기본 켬, 끄려면 0)
# LD_WISDOM=1

# 판정 응답 캐시 보관 일수(기본 30, 1~30). 응답에 사업 설명 일부가 섞일 수 있어 줄일 수 있음
# LD_ANSWER_CACHE_DAYS=30
# HTTPS 강제 헤더(HSTS). 기본 켬. 같은 도메인의 다른 서비스에도 적용되므로 문제가 있으면 0
# LD_HSTS=1
